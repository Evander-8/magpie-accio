    "src",
    "icons",
    "publish",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "magpie",
    "magpie-plugin",
    "opencode",
    "opencode-plugin",
    "accio",
    "alibaba",
    "provider",
    "openai-compatible"
  ],
  "author": "Evander-8",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Evander-8/magpie-accio.git"
  },
  "homepage": "https://github.com/Evander-8/magpie-accio#readme",
  "bugs": {
    "url": "https://github.com/Evander-8/magpie-accio/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node ./test/run.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "magpie": {
    "maxConcurrency": 4
  }
}
